# Google OAuth client ID for Google Identity Services.
# Leave empty to use the local demo identity instead.
# Authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Server-side NVIDIA NIM key. Read only by the Vite dev/preview server and
# never exposed to the browser. The local `key` file is also supported.
NVIDIA_API_KEY=

# Optional server-side model overrides. One per app model; the variable name
# is the app ID uppercased with dashes as underscores. Defaults are shown.
# NVIDIA_MODEL_NEMOTRON_LIGHTNING=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_MODEL_NEMOTRON_NANO_OMNI=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA_MODEL_LAGUNA_XS=poolside/laguna-xs-2.1
# NVIDIA_MODEL_MINIMAX_FLASH=minimaxai/minimax-m3.1-flash
# NVIDIA_MODEL_MUSE_GLIMMER=meta/muse-glimmer-30b
# NVIDIA_MODEL_MISTRAL_LARGE_4=mistralai/mistral-large-4-1t-a52b
# NVIDIA_MODEL_NEMOTRON_SUPER_VL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_MODEL_NEMOTRON_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_MODEL_DEEPSEEK_FLASH=deepseek-ai/deepseek-v4.1-flash
